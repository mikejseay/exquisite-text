{
  "name": "exquisite",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "corepack enable && yarn set version 4.4.0",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "npx biome check .",
    "lint:fix": "npx biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "moduleDirectories": ["node_modules", "."]
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "jest": "^30.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@4.13.0"
}
