{
  "extends": "@tsconfig/node16/tsconfig.json",
  "compilerOptions": {
    "target": "es5",
    "downlevelIteration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "../src/types",
    "../src/constants",
    "../src/helpers"
  ],
  "exclude": [
    "node_modules"
  ]
}
