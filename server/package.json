{
  "name": "exquisite-server-js",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@langchain/openai": "^0.0.33",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "langchain": "^0.2.2",
    "morgan": "^1.10.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.5.1",
    "socket.io-client": "^4.5.1",
    "typescript": "^4.7.4"
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.3",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.13",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.0.6",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "startwatch": "node --watch --env-file-if-exists=.env --import tsx -r tsconfig-paths/register start.ts",
    "start": "node --env-file-if-exists=.env --import tsx -r tsconfig-paths/register start.ts",
    "test": "OPENAI_API_KEY=test-dummy node --import tsx --test --test-force-exit './__tests__/**/*.test.ts'",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --ext .ts --max-warnings 0 --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "yarn@4.4.0"
}
