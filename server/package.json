{
    "name": "exquisite-server-js",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@langchain/openai": "^0.0.33",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "langchain": "^0.2.2",
        "pino": "^9",
        "pino-http": "^10.0.0",
        "pino-pretty": "^13.0.0",
        "socket.io": "^4.5.1",
        "socket.io-client": "^4.5.1",
        "typescript": "^5.8.0"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@types/cookie-parser": "^1.4.3",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "startwatch": "node --watch --env-file-if-exists=.env --import tsx -r tsconfig-paths/register start.ts",
        "start": "node --env-file-if-exists=.env --import tsx -r tsconfig-paths/register start.ts",
        "test": "OPENAI_API_KEY=test-dummy node --import tsx --test --test-force-exit './__tests__/**/*.test.ts'",
        "lint": "npx biome check .",
        "lint:fix": "npx biome check --write .",
        "typecheck": "tsc --noEmit"
    },
    "packageManager": "yarn@4.13.0"
}
